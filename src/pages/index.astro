---
import Badge from "../components/Badge.astro";
import SocialNetwork from "../components/SocialNetwork.astro";
import PackagesIcon from "../components/icons/Packages.astro";
import LinkedinIcon from "../components/icons/LinkedIn.astro";
import GithubIcon from "../components/icons/Github.astro";
import MailIcon from "../components/icons/mail.astro";
import BriefcaseIcon from "../components/icons/Briefcase.astro";
import SectionContainer from "../components/SectionContainer.astro";
import Layout from "../layouts/Layout.astro";
import Experience from "../components/Experience.astro";
---

<Layout
    title="Portfolio de sanzcarlos"
    description="Solution architecture for cloud and hybrid environments, Systems integration and process automation, Collaboration and productivity with Microsoft Teams"
>
    <SectionContainer class="py-44 pb-22">
        <h1 class="text-white text-5xl font-bold flex flex-row gap-x-4 pb-5">
            Hi, I'm Carlos <a
                href="https://www.linkedin.com/in/sanzcarlos/"
                target="_blank"
                rel="noopener"
                class="flex justify-center items-center"
            >
                <Badge>Developer</Badge><Badge>Solutions Architect</Badge>
            </a>
        </h1>
        <h2 class="text-xl">
            I'm a Solutions Architect with extensive experience in designing and
            implementing scalable, secure systems. My approach combines
            technological innovation with strategic vision to help organizations
            optimize processes and achieve their goals.
        </h2>
        <nav class="flex gap-x-4 mt-8">
            <SocialNetwork href="https://www.linkedin.com/in/sanzcarlos/">
                <LinkedinIcon class="size-6" />
                LinkedIn
            </SocialNetwork>
            <SocialNetwork href="https://www.github.com/sanzcarlos/">
                <GithubIcon class="size-6" />
                Github
            </SocialNetwork>
            <SocialNetwork href="mailto:carlos.sanzpenas@gmail.com">
                <MailIcon class="size-6" />
                carlos.sanzpenas@gmail.com
            </SocialNetwork>
        </nav>
    </SectionContainer>
    <SectionContainer id="experience">
        <h2 class="text-2xl font-semibold flex gap-x-2 mb-6 items-center">
            <BriefcaseIcon class="size-7" /> Work Experience
        </h2>
        <Experience />
    </SectionContainer>
    <SectionContainer id="project">
        <h2 class="text-2xl font-semibold flex gap-x-2 mb-6 items-center">
            <PackagesIcon class="size-7" /> Projects
        </h2>
    </SectionContainer>
</Layout>
