---
import type { ACTION_ERROR_CODES, ACTION_QUERY_PARAMS } from "astro:actions";

interface ExperienceItemProps {
    title: string;
    description: string;
    company: string;
    datestart: string;
    dateend: string;
    latest?: boolean;
    link?: string;
}

const { title, description, company, latest, datestart, dateend, link } =
    Astro.props;

import Badge from "./Badge.astro";
---

<span
    class="absolute flex items-center justify-center size-6 bg-brand-softer rounded-full -start-3 ring-8 ring-buffer"
>
    <svg
        class="size-7 text-blue-900"
        aria-hidden="true"
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        fill="none"
        viewBox="0 0 24 24"
        ><path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 10h16m-8-3V4M7 7V4m10 3V4M5 20h14a1 1 0 0 0 1-1V7a1 1 0 0 0-1-1H5a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1Zm3-7h.01v.01H8V13Zm4 0h.01v.01H12V13Zm4 0h.01v.01H16V13Zm-8 4h.01v.01H8V17Zm4 0h.01v.01H12V17Zm4 0h.01v.01H16V17Z"
        ></path></svg
    >
</span>
<Badge class="ml-3">{datestart}</Badge>
{dateend && <Badge class="ml-3">{dateend}</Badge>}

<h3 class="text-xl font-bold text-gray-600 dark:text-blue-300">
    {title}
    {
        latest && (
            <>
                <Badge class="ml-3">Latest</Badge>
            </>
        )
    }
</h3>
<h4 class="font-semibold text-xl text-gray-600 dark:text-indigo-300">
    {company}
</h4>

<p class="mb-4 text-body dark:text-gray-50">{description}</p>
{
    link && (
        <a
            href={link}
            class="inline-flex items-center text-body bg-neutral-secondary-medium box-border border border-default-medium hover:bg-neutral-tertiary-medium hover:text-heading focus:ring-4 focus:ring-neutral-tertiary shadow-xs font-medium leading-5 rounded-base text-sm px-4 py-2.5 focus:outline-none"
        >
            <svg
                class="w-4 h-4 me-1.5 -ms-0.5"
                aria-hidden="true"
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                fill="none"
                viewBox="0 0 24 24"
            >
                <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-width="2"
                    d="M10 3v4a1 1 0 0 1-1 1H5m14-4v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V7.914a1 1 0 0 1 .293-.707l3.914-3.914A1 1 0 0 1 9.914 3H18a1 1 0 0 1 1 1Zm-4 1h.01v.01H15V5Zm-2 2h.01v.01H13V7Zm2 2h.01v.01H15V9Zm-2 2h.01v.01H13V11Zm2 2h.01v.01H15V13Zm-2 2h.01v.01H13V15Zm2 2h.01v.01H15V17Zm-2 2h.01v.01H13V19Z"
                />
            </svg>
            Download ZIP
        </a>
    )
}
