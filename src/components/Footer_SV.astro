---
const currentYear = new Date().getFullYear();
---

<footer
    class="opacity-80 m-4 mt-16 w-full mx-auto container lg:max-w-4xl md:max-w-2xl mb-10 flex justify-center"
>
    <div class="rounded-lg w-full max-w-7xl mx-auto py-4 text-center">
        <span class="text-sm text-zinc-800/90 dark:text-zinc-200/90"
            >&copy; {currentYear}
            <a href="https://sanzcarlos.github.io/" class="hover:underline"
                >sanzcarlos</a
            >. Casi todos los derechos reservados
        </span>
    </div>
</footer>
